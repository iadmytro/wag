-- String basics (§3 / §9): a packed UTF-8 byte buffer, non-pointer-free and linear.
-- Pure functions so the pipeline harness can drive them via `call_fn`.

-- Length in bytes.
lenHello = Int:  -> stringLen "hello"

-- "hé" = 'h' (1 byte) + 'é' (2 bytes) = 3 bytes, though 2 codepoints.
lenUtf8 = Int:  -> stringLen "hé"

-- Concatenation then length.
concatLen = Int:  -> stringLen (stringConcat "ab" "cd")

-- Structural equality.
eqSame = Bool:  -> "ab" == "ab"

eqDiff = Bool:  -> "ab" == "ac"

-- Codepoint bridge (non-ASCII): "hé" -> [104, 233].
cps = List Int:  -> vecToList (stringToCodepoints "hé")

-- Round-trip through codepoints preserves the string.
roundtrip = Bool:  -> codepointsToString (stringToCodepoints "hé") == "hé"
