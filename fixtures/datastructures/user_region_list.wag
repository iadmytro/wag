-- User-declared region type with methods: doubly-linked list.
-- Exercises the full method machinery (D056/D057) on a non-prelude type,
-- cursor walks, and tail-recursive handle threading at top level.

DLNode = DLEnd | DLNodeC val Int next (Ref DLNode) prev (Ref DLNode)
DLH = DLH head (Ref DLNode) tail (Ref DLNode) len Int

dlNew = DLH: ->
  a = DLEnd
  b = DLEnd
  DLH a b 0

-- Initialize with a single element.
DLH.init = Int -> DLH: v ->
  n = DLNodeC v DLEnd DLEnd
  head <- n
  tail <- n
  len <- 1
  self

-- Append at the tail (O(1)).
DLH.append = Int -> DLH: v ->
  n = DLNodeC v DLEnd tail
  tail.next <- n
  tail <- n
  len <- len + 1
  self

-- Prepend at the head (O(1)).
DLH.prepend = Int -> DLH: v ->
  n = DLNodeC v head DLEnd
  head.prev <- n
  head <- n
  len <- len + 1
  self

-- Read-only: value under the head cursor.
DLH.headVal = Option Int: -> match head
  DLEnd     -> None
  DLNodeC v _ _ -> Some v

-- Single-step forward (D057): move a local cursor; returns (value, new handle).
-- Since we only track head/tail in the handle, this is a no-op structurally —
-- but it exercises the match-on-link pattern.
DLH.step = Option Int: -> match head
  DLEnd        -> None
  DLNodeC v _ _ -> Some v

buildFive = DLH: ->
  h0 = dlNew
  h1 = h0.init 10
  h2 = h1.append 20
  h3 = h2.append 30
  h4 = h3.prepend 5
  h5 = h4.append 40
  h5

testReport = (Int, Option Int): ->
  h = buildFive
  (h.len, h.headVal)
