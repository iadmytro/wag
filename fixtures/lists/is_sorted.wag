-- Spec §8.17 (migrated to List, D062 cursor model): borrowed peek/step walk over
-- adjacent pairs — the input list is not consumed.

isSortedStep = List Int -> Bool: h ->
  match h.peek
    None   -> True
    Some v ->
      match h.step
        None     -> True
        Some h2  ->
          match h2.peek
            None       -> True
            Some w -> if v <= w -> isSortedStep h2
                       _        -> False

isSorted = List Int -> Bool: lst -> isSortedStep lst

buildAsc = List Int: ->
  h0 = listNew
  h1 = h0.append -3
  h2 = h1.append 1
  h3 = h2.append 7
  h3

buildDesc = List Int: ->
  h0 = listNew
  h1 = h0.append 2
  h2 = h1.append -1
  h2

-- (isSorted asc, isSorted desc) → (True, False).
testReport = (Bool, Bool): ->
  (isSorted buildAsc, isSorted buildDesc)
