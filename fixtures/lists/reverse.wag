-- Spec §8.5 (migrated to List, D062 cursor model): borrowed peek/step walk
-- prepending each element onto a fresh accumulator — the original's
-- accumulate-then-reverse idiom in its O(1)-prepend form.

specReverseH = List Int, List Int -> List Int: lst, acc ->
  match lst.peek
    None   -> acc
    Some h ->
      acc2 = acc.prepend h
      match lst.step
        None   -> acc2
        Some t -> specReverseH t acc2

specReverse = List Int -> List Int: lst ->
  a0 = listNew
  specReverseH lst a0

buildThree = List Int: ->
  h0 = listNew
  h1 = h0.append 1
  h2 = h1.append 2
  h3 = h2.append 3
  h3

-- (head, length) of reverse [1, 2, 3] → (3, 3). The prepend-built result
-- carries its cursor at the last element (same as prelude reverse), so
-- rewind before peeking.
testReport = (Int, Int): ->
  r0 = specReverse buildThree
  r = r0.rewind
  match r.peek
    Some v -> (v, length r)
    None   -> (-1, -1)
