-- Spec §8.3 (migrated to List, D062 cursor model): borrowed peek/step walk —
-- the input list is not consumed and stays reusable after `sumList`.

sumHelper = List Int, Int -> Int: lst, acc ->
  match lst.peek
    None   -> acc
    Some h ->
      acc2 = acc + h
      match lst.step
        None   -> acc2
        Some t -> sumHelper t acc2

sumList = List Int -> Int: lst -> sumHelper lst 0

buildFive = List Int: ->
  h0 = listNew
  h1 = h0.append 1
  h2 = h1.append 2
  h3 = h2.append 3
  h4 = h3.append 4
  h5 = h4.append 5
  h5

-- (sum of [1..5], head of the untouched input) → (15, 1).
-- rule 10: `sumList` consumes its owned handle, so pass a copy to keep `xs`
-- reusable afterwards.
testReport = (Int, Int): ->
  xs = buildFive
  s = sumList (copy xs)
  match xs.peek
    Some v -> (s, v)
    None   -> (-1, -1)
