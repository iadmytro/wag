-- Spec §8.6 (migrated to List, D062 cursor model): borrowed peek/step walk
-- appending each image to a fresh output list — O(1) tail append removes the
-- original's accumulate-then-reverse step entirely.

increment = Int -> Int: x -> x + 1

specMapH = (Int -> Int), List Int, List Int -> List Int: f, lst, out ->
  match lst.peek
    None   -> out
    Some h ->
      out2 = out.append (f h)
      match lst.step
        None   -> out2
        Some t -> specMapH f t out2

specMap = (Int -> Int), List Int -> List Int: f, lst ->
  o0 = listNew
  specMapH f lst o0

buildThree = List Int: ->
  h0 = listNew
  h1 = h0.append 1
  h2 = h1.append 2
  h3 = h2.append 3
  h3

-- (head, length) of map increment [1, 2, 3] → (2, 3).
testReport = (Int, Int): ->
  m = specMap increment buildThree
  match m.peek
    Some v -> (v, length m)
    None   -> (-1, -1)
